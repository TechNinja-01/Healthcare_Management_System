# Copy to .env (same folder as docker-compose.yml) and fill in real values.
# docker compose reads this file automatically for ${VAR} substitution.

# --- Public domain (DuckDNS is free): e.g. myapp.duckdns.org ---
DOMAIN=myapp.duckdns.org
ACME_EMAIL=you@example.com

# --- Database (used by both the db and backend containers) ---
DB_NAME=hms
DB_USER=hms_user
DB_PASSWORD=change-me-strong-password

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Razorpay (test keys are fine for dev) ---
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# --- WebRTC ICE (STUN is free; TURN optional for now) ---
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Recordings: Cloudflare R2 (S3-compatible) ---
# Endpoint is the host only (no https://): <accountid>.r2.cloudflarestorage.com
MINIO_ENDPOINT=<accountid>.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=<r2-access-key-id>
MINIO_SECRET_KEY=<r2-secret-access-key>
MINIO_BUCKET=consultation-recordings
MINIO_SECURE=true

# --- Frontend build-time keys ---
VITE_GOOGLE_MAPS_API_KEY=
